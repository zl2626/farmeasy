# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Enable these in HTTPS production deployments
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Email. The default backend prints mail to the development console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional external services
DATA_GOV_API_KEY=
SCHEMES_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=
MONGO_URI=
MARKET_DATA_PROVIDER=education.market.providers.SnapshotMarketProvider

# API throttling
DRF_ANON_RATE=60/min
DRF_USER_RATE=300/min
DRF_AUTH_RATE=10/min
DRF_FEEDBACK_RATE=10/hour
DRF_AI_RATE=30/hour
DRF_SCRAPE_RATE=5/hour
