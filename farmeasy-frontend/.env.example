# Vercel with the repository-root Python backend uses same-origin /api.
# GitHub Pages must use the absolute HTTPS URL of that Vercel deployment.
# Leave these unset for local development and same-origin Vercel deployments.
# Only set these for a separately hosted frontend such as GitHub Pages:
# VITE_API_BASE_URL=https://your-backend.example.com/api
# VITE_MEDIA_ORIGIN=https://your-backend.example.com
# Local Vite proxy target defaults to http://127.0.0.1:8001.
# Override with the API_PROXY_TARGET shell environment variable if needed.
